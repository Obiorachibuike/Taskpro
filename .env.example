# Mobile: set extra.apiUrl in app.json (Android emulator uses http://10.0.2.2:4000).
# Never embed JWT_SECRET or DATABASE_URL in the Expo application.
PORT=4000
DATABASE_URL=postgresql://taskpro:taskpro@localhost:5432/taskpro
DATABASE_SSL=false
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGIN=*
# EAS projectId can be added under expo.extra.eas.projectId after `eas init`.
